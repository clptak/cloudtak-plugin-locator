{
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "baseUrl": ".",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ESNext",
        "lib": ["dom", "esnext"],
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "strict": true,
        "noImplicitThis": true,
        "verbatimModuleSyntax": true,
        "useDefineForClassFields": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "types": ["vue"],
        "paths": {
            "@/stores/app.ts": ["./stubs/app-store.ts"],
            "@/stores/map.ts": ["./stubs/map-store.ts"],
            "@/base/group.ts": ["./stubs/group.ts"],
            "@/base/overlay.ts": ["./stubs/overlay.ts"],
            "@/base/overlay-class.ts": ["./stubs/overlay-class.ts"],
            "@/std.ts": ["./stubs/std.ts"],
            "../../../src/std.ts": ["./stubs/std.ts"],
            "../../../src/stores/map.ts": ["./stubs/map-store.ts"],
            "../../../src/stores/float.ts": ["./stubs/float-store.ts"],
            "../../../src/components/CloudTAK/util/FloatingPane.vue": ["./stubs/FloatingPane.vue"],
            "../../../../src/stores/map.ts": ["./stubs/map-store.ts"],
            "../../../../src/std.ts": ["./stubs/std.ts"],
            "@/*": ["../../CloudTAK/api/web/src/*"]
        }
    },
    "include": ["env.d.ts", "**/*.ts", "**/*.vue"]
}
